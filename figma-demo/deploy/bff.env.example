# Copy to `bff.env` next to docker-compose.cz-life-test.yml (never commit real secrets).

IPDEX_CLIENT_ORIGIN=https://ipdex-v1-dev.ipdex.vip
IPDEX_GATEWAY_PREFIX=
IPDEX_PARTNER_COBRAND_PREFIX=/partner/integration/book-site

IPDEX_PARTNER_APP_KEY=
IPDEX_PARTNER_APP_SECRET=

# Default primary listing (`POST /api/bff/orders/primary` bodies may omit listingId).
# Dev: a6d4e2eb-1c33-4569-b988-333656580ea3 — Prod «幣安人生»: 8751f4d8-f815-49fa-83b4-6186a20cb616
BOOK_PRIMARY_LISTING_ID=a6d4e2eb-1c33-4569-b988-333656580ea3

# Free STANDARD tier — Admin → Airdrop campaign → publicCode (set after prod campaign exists)
BOOK_STANDARD_AIRDROP_PUBLIC_CODE=cz-nft-free-test-2
# Optional default for chronicle FD claims when SPA omits publicCode (SPA usually passes it).
BOOK_CHRONICLE_AIRDROP_PUBLIC_CODE=czlife-chronicle-fd-test

BFF_PORT=8787
BOOK_ALLOWED_ORIGINS=https://czlife.club,https://www.czlife.club
BOOK_COOKIE_SECURE=1

# Stripe Checkout success → {origin}/purchase-success?orderId=… (requires matching IPDEX COBRAND_BOOK_STRIPE_CALLBACK)
BOOK_STRIPE_CALLBACK_ORIGIN=https://czlife.club

# Rising Star Author ranking (「人气新锐作者打榜」) — off until ENABLED=1
# sync: TOP3 offline ticket + TOP4-10 merch | async: TOP10 merch only
# CHRONICLE_RANK_ENABLED=1
# CHRONICLE_RANK_MODE=sync
# CHRONICLE_RANK_START=2026-08-18T00:00:00+08:00
# CHRONICLE_RANK_END=2026-08-26T23:59:59+08:00
# CHRONICLE_RANK_DATA_DIR=/data/chronicle-rank
