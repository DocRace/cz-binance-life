# Example: single hostname serves SPA + proxies /api/bff/* to the book BFF.
# Copy to your gateway repo, replace BOOKSITE_BFF_UPSTREAM, and tune TLS/server_name.

server {
    listen 80;
    server_name cz-life-test.example.com;

    root /usr/share/nginx/html;
    index index.html;

    location /api/bff/ {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Isolated partner deck — static only, never falls through to the SPA.
    location = /partner-deck {
        return 301 /partner-deck/;
    }
    location /partner-deck/ {
        try_files $uri $uri/ /partner-deck/index.html;
        add_header Cache-Control "no-cache";
    }

    location = /cover-showcase {
        return 301 /cover-showcase/;
    }
    location /cover-showcase/ {
        try_files $uri $uri/ /cover-showcase/index.html;
        add_header Cache-Control "no-cache";
    }

    location = /invite {
        return 301 /invite/;
    }
    location /invite/ {
        try_files $uri $uri/ /invite/index.html;
        add_header Cache-Control "no-cache";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
